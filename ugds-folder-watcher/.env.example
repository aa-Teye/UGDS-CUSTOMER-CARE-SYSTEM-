# ========================================================
# UGDS FOLDER WATCHER CONFIGURATION
# ========================================================

# Arkesel API Credentials (Get from Arkesel Dashboard -> Developers / API Keys)
ARKESEL_API_KEY=YOUR_ARKESEL_API_KEY_HERE
ARKESEL_SENDER_ID=UGDS

# Safety Mode:
# When DRY_RUN=True, SMS is NOT sent through Arkesel, it only prints to console and logs to DB.
# Set DRY_RUN=False when you are ready to send real SMS!
DRY_RUN=True

# Directory to watch for tracker files
# You can use an absolute path like C:\HospitalRecords or a relative path ./incoming_files
WATCH_FOLDER=./incoming_files

# If watching a single specific file that is continuously appended to, specify its full path here.
# Leave blank if you are dropping new .txt files into WATCH_FOLDER.
SPECIFIC_TRACKER_FILE=

# Patient Survey Link Base URL
SURVEY_BASE_URL=https://ugds-customer-experience.vercel.app/feedback

# SMS Message Template (Placeholders: {name}, {folder}, {link})
SMS_MESSAGE_TEMPLATE=Dear {name}, thank you for visiting UGDS (Folder: {folder}). We care about your health and experience. Please rate our service here: {link}

# Duplicate Prevention:
# Minimum days before the same folder number / phone can be sent another SMS survey (default 7 days)
COOLDOWN_DAYS=7
